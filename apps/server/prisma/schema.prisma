generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  donor
  platform
  ngo
  worker
  village
}

enum DonationStatus {
  queued
  matched
  in_transit
  delivered
}

enum DonationCategory {
  food
  clothing
  medical
  infrastructure
  other
}

enum RequestStatus {
  pending
  matched
  in_transit
  fulfilled
}

enum RequestUrgency {
  critical
  high
  medium
  low
}

enum RequestType {
  food
  clothing
  medical
  volunteers
  infrastructure
  education
}

enum NgoVerificationStatus {
  pending
  under_review
  approved
  rejected
}

enum WorkerStatus {
  available
  assigned
  on_leave
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  location        String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  donorProfile    DonorProfile?
  ngoProfile      NgoProfile?
  workerProfile   WorkerProfile?
  villageProfile  VillageProfile?
}

// ─── Donor ────────────────────────────────────────────────────────────────────
model DonorProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  orgName     String?
  donations   Donation[]
}

model Donation {
  id               String           @id @default(cuid())
  donorProfileId   String
  donorProfile     DonorProfile     @relation(fields: [donorProfileId], references: [id])
  category         DonationCategory
  itemName         String
  quantity         Int
  unit             String
  status           DonationStatus   @default(queued)
  matchedNgoId     String?
  matchedVillageId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  villageRequest   VillageRequest?  @relation(fields: [matchedVillageId], references: [id])
}

// ─── NGO ──────────────────────────────────────────────────────────────────────
model NgoProfile {
  id                 String                @id @default(cuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id])
  orgName            String
  state              String
  focusAreas         RequestType[]
  verificationStatus NgoVerificationStatus @default(pending)
  projects           NgoProject[]
  workerAssignments  WorkerAssignment[]
}

model NgoProject {
  id               String           @id @default(cuid())
  ngoProfileId     String
  ngoProfile       NgoProfile       @relation(fields: [ngoProfileId], references: [id])
  title            String
  description      String
  location         String
  progressPercent  Int              @default(0)
  workersNeeded    Int
  status           String           @default("active")
  assignments      WorkerAssignment[]
  createdAt        DateTime         @default(now())
}

// ─── Worker ───────────────────────────────────────────────────────────────────
model WorkerProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id])
  skills           String[]
  preferredWork    String
  status           WorkerStatus       @default(available)
  availableFrom    DateTime
  rating           Float              @default(0)
  daysWorked       Int                @default(0)
  resourcesEarned  Float              @default(0)
  assignments      WorkerAssignment[]
}

model WorkerAssignment {
  id               String        @id @default(cuid())
  workerProfileId  String
  workerProfile    WorkerProfile @relation(fields: [workerProfileId], references: [id])
  ngoProfileId     String
  ngoProfile       NgoProfile    @relation(fields: [ngoProfileId], references: [id])
  projectId        String
  project          NgoProject    @relation(fields: [projectId], references: [id])
  taskDescription  String
  progressPercent  Int           @default(0)
  startDate        DateTime
  endDate          DateTime?
  status           String        @default("active")
  createdAt        DateTime      @default(now())
}

// ─── Village ──────────────────────────────────────────────────────────────────
model VillageProfile {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id])
  villageName  String
  state        String
  district     String
  requests     VillageRequest[]
}

model VillageRequest {
  id                String         @id @default(cuid())
  villageProfileId  String
  villageProfile    VillageProfile @relation(fields: [villageProfileId], references: [id])
  requestType       RequestType
  urgency           RequestUrgency
  quantity          Int
  familiesAffected  Int
  requiredBy        DateTime
  details           String
  status            RequestStatus  @default(pending)
  donations         Donation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
